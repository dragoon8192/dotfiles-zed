// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
    // # Disablement
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-t": null
        }
    },
    {
        "context": "Editor",
        "bindings": {
            // "pane:CloseActiveItem"
            "shift-z shift-q": null,
            "ctrl-t": null,
            // "editor:ShowCompletions"
            "ctrl-space": null
        }
    },

    // # Movement
    //
    // Dvorak 配列に変更
    //
    // | Default  | Custom    | Editor Action          | menu Action            |
    // | :------- | :-------- | :--------------------- | :--------------------- |
    // | "h"      | "d"       | "vim::Left"            | Collapse               |
    // | "j"      | "h"       | "vim::Down"            | Expand                 |
    // | "k"      | "t"       | "vim::Up"              | "menu::SelectNext"     |
    // | "l"      | "n"       | "vim::Right"           | "menu::SelectPrevious" |
    // | "shift-g"| "shift-g" | "vim::EndOfDocument"   | "menu::SelectFirst"    |
    // | "g g"    | "g g"     | "vim::StartOfDocument" | "menu::SelectLast"     |
    //
    // ## Editor
    {
        "context": "VimControl && !menu",
        "bindings": {
            "d": "vim::Left",
            "h": "vim::Down",
            "t": "vim::Up",
            "n": "vim::Right",
            "g g": "vim::StartOfDocument",
            "shift-g": "vim::EndOfDocument",
        }
    },
    // ## menu
    {
        "context": "menu && not_editing",
        "bindings": {
          "h": "menu::SelectNext",
          "t": "menu::SelectPrevious",
          "shift-g": "menu::SelectLast",
          "g g": "menu::SelectFirst"
        }
    },
    // ### ProjectPanel
    {
        "context": "ProjectPanel && not_editing",
        "bindings": {
          "d": "project_panel::CollapseSelectedEntry",
          "n": "project_panel::ExpandSelectedEntry",
        }
    },
    // ### OutlinePanel
    {
        "context": "OutlinePanel && not_editing",
        "bindings": {
          "d": "outline_panel::CollapseSelectedEntry",
          "n": "outline_panel::ExpandSelectedEntry",
        }
    },

    // # Delete Operator
    //
    // Dvorak 配列に変更
    //
    // | Default   | Custom    | Action            |
    // | :-------- | :-------- | :---------------- |
    // | "d"       | "k"       | PushDelete        |
    // | "shift-d" | "shift-k" | DeleteToEndOfLine |
    //
    // ## normal
    {
        "context": "vim_mode == normal",
        "bindings": {
            "k": "vim::PushDelete",
            "shift-k": "vim::DeleteToEndOfLine",
        }
    },
    // ## operator
    {
        "context": "vim_operator == d",
        "bindings": {
            "k": "vim::CurrentLine",
            "s": "vim::PushDeleteSurrounds",
            // "editor::ToggleSelectedDiffHunks"
            "o": null,
            // "git::ToggleStaged",
            "shift-o": null,
            // "git::Restore"
            "p": null,
            // "git::StageAndNext"
            "u": null,
            // "git::UnstageAndNext"
            "shift-u": null
        }
    },
    // ## visual
    {
        "context": "vim_mode == visual",
        "bindings": {
            "k": "vim::VisualDelete",
            "shift-k": "vim::VisualDeleteLine",
        }
    },

    // # Match
    //
    // Dvorak 配列に変更
    //
    // | Default   | Custom    | Action            |
    // | :-------- | :-------- | :---------------- |
    // | "n"       | "s"       | PushDelete        |
    // | "shift-n" | "shift-s" | DeleteToEndOfLine |
    //
    // ## normal
    {
        "context": "VimControl && !menu && !vim_operator",
        "bindings": {
            "s": "vim::MoveToNextMatch", // n
            "shift-s": "vim::MoveToPreviousMatch", // shift-n
        }
    },

    // # Comments
    //
    // | Default   | Custom    | Action                    |
    // | :-------- | :-------- | :------------------------ |
    // | "g c"     | "space c" | "vim::PushToggleComments" |
    //
    {
        "context": "vim_mode == normal || vim_mode == visual",
        "bindings": {
            "g c": null,
            "space c": "vim::PushToggleComments",
        }
    },

    // # Language Server
    //
    // | Default   | Custom    | Action                           |
    // | :-------- | :-------- | :------------------------------- |
    // |           | "space ]" | "editor::GoToDiagnostic"         |
    // |           | "space [" | "editor::GoToPreviousDiagnostic" |
    // |           | "space d" | "editor::GoToDefinition"         |
    // |           | "space a" | "editor::ToggleCodeActions"      |
    // |           | "space h" | "editor::Hobar"                  |
    //
    {
        "context": "vim_mode == normal",
        "bindings": {
            "space ]": "editor::GoToDiagnostic",
            "space [": "editor::GoToPreviousDiagnostic",
            "space d": "editor::GoToDefinition",
            "space a": "editor::ToggleCodeActions",
            "space h": "editor::Hover"
        }
    },
    {
        // # Editor VimControl vim_mode == normal
        "context": "vim_mode == normal",
        "bindings": {
            // ## Workspace
            "space w": "workspace::Save",
            // ## Git
            "ctrl-g shift-s": "git::StageAll",
            "ctrl-g ctrl-shift-s": "git::StageAll",
            "ctrl-g s": "git::StageAndNext",
            "ctrl-g ctrl-s": "git::StageAndNext",
            "ctrl-g shift-u": "git::UnstageAll",
            "ctrl-g ctrl-shift-u": "git::UnstageAll",
            "ctrl-g u": "git::UnstageAndNext",
            "ctrl-g ctrl-u": "git::UnstageAndNext",
            "ctrl-g c": "git::ExpandCommitEditor",
            "ctrl-g ctrl-c": "git::ExpandCommitEditor",

            // ### File Finder
            "ctrl-p": null,
            "ctrl-p s": "file_finder::Toggle",
            "ctrl-p ctrl-s": "file_finder::Toggle",
            // ### Diagnostic
            "ctrl-p d": "diagnostics::Deploy",
            "ctrl-p ctrl-d":  "diagnostics::Deploy",
        }
    },
    {
        // # Editor VimControl vim_mode == insert
        "context": "vim_mode == insert",
        "bindings": {
            // ## Completions
            "ctrl-x": null,
            "ctrl-x ctrl-n": "editor::ShowCompletions",
            "ctrl-x ctrl-p": "editor::ShowCompletions",

        }
    },
    {
        "context": "((GitCommit || CommitEditor) > Editor) && (vim_mode == normal || vim_mode == insert)",
        "bindings": {
            "ctrl-g a": "git::GenerateCommitMessage"
        }
    },
    {
        "context": "(VimControl && !menu) || Editor",
        "bindings": {
            // # Window
            "ctrl-w": null,
            "ctrl-w t": "workspace::ActivatePaneUp",
            "ctrl-w h": "workspace::ActivatePaneDown",
            "ctrl-w d": "workspace::ActivatePaneLeft",
            "ctrl-w n": "workspace::ActivatePaneRight",
            "ctrl-w ctrl-t": "workspace::ActivatePaneUp",
            "ctrl-w ctrl-h": "workspace::ActivatePaneDown",
            "ctrl-w ctrl-d": "workspace::ActivatePaneLeft",
            "ctrl-w ctrl-n": "workspace::ActivatePaneRight",

            // ### Pane (Tab)
            "ctrl-t": "pane::ActivateNextItem",
            "ctrl-shift-t": "pane::ActivatePreviousItem",

            // ## Dock
            "ctrl-d d": "workspace::ToggleLeftDock",
            "ctrl-d h": "workspace::ToggleBottomDock",
            "ctrl-d s": "workspace::ToggleRightDock",

            // ### Git Panel
            "ctrl-d g": "git_panel::ToggleFocus",
            "ctrl-d ctrl-g": "git_panel::ToggleFocus",
            "ctrl-d shift-g": "workspace::CloseActiveDock",
            // ### Outline
            "ctrl-d o": "outline_panel::ToggleFocus",
            "ctrl-d ctrl-o": "outline_panel::ToggleFocus",
            "ctrl-d shift-o": "workspace::CloseActiveDock",
            // ### Project
            "ctrl-d p": "project_panel::ToggleFocus",
            "ctrl-d ctrl-p": "project_panel::ToggleFocus",
            "ctrl-d shift-p": "workspace::CloseActiveDock"
        }
    },
    {
        "context": "vim_mode == insert",
        "bindings": {
            "h h": "vim::NormalBefore"
        }
    },
    {
        "context": "GitPanel && ChangesList && !GitBranchSelector",
        "use_key_equivalents": true,
        "bindings": {
            "i": "git_panel::FocusEditor",
            "ctrl-g c": "git_panel::FocusEditor",
            "ctrl-g ctrl-c": "git_panel::FocusEditor",
            "x": "git::ToggleStaged",
            "shift-x": "git::StageAll",
            "shift-u": "git::UnstageAll"
        }
    },
    {
        // netrw compatibility
        "context": "ProjectPanel && not_editing",
        "bindings": {
            ":": "command_palette::Toggle",
            // ## New
            "i": "project_panel::NewFile",
            "/": "project_panel::NewSearchInDirectory",
            "o": "project_panel::NewDirectory",
            // ## Open
            "enter": "project_panel::OpenPermanent",
            "escape": "project_panel::ToggleFocus",
            // ## Action
            "k k": "project_panel::Cut",
            "y y": "project_panel::Copy",
            "shift-k": "project_panel::Delete",
            "p": "project_panel::Paste",
            "r r": "project_panel::Rename",
            "v": "project_panel::OpenPermanent",
            "x": "project_panel::RevealInFileManager",
            "s": "project_panel::OpenWithSystem",
            "] c": "project_panel::SelectNextGitEntry",
            "[ c": "project_panel::SelectPrevGitEntry",
            "] d": "project_panel::SelectNextDiagnostic",
            "[ d": "project_panel::SelectPrevDiagnostic",
            "}": "project_panel::SelectNextDirectory",
            "{": "project_panel::SelectPrevDirectory",
            "-": "project_panel::SelectParent"
        }
    },
    // GitPanel
    {
        "context": "GitPanel",
        "bindings": {
            "ctrl-space": null,
            "ctrl-c r": "git::SelectRepo",
            "ctrl-c ctrl-r": "git::SelectRepo",
            "ctrl-c b": "git::Switch",
            "ctrl-c ctrl-b": "git::Switch",
        }
    },
    {
        "context": "GitRepositorySelector",
        "bindings": {
        }
    },
    {
        "context": "Editor && language == Markdown && vim_mode == insert",
        "bindings": {
            "ctrl-alt-d": [
                "editor::InsertSnippet",
                {
                    "snippet": "$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_HOUR:$CURRENT_MINUTE"
                }
            ]
        }
    },
    // # AcpThread
    {
        "context": "AcpThread || AcpThread > Editor",
        "bindings": {
            // ## Disablement
            "ctrl-i": null,
            "shift-tab": null
        }
    }
]
